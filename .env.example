# ---------------------------------------------------------------------------
# Minimal local setup
# Fill this part first if you only want to run the app locally.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
# Single model for all agents. Dual-read: prefer PM_PAL_LLM
# Legacy SMART_LLM / FAST_LLM / STRATEGIC_LLM still accepted as fallbacks.
PM_PAL_LLM=openai:gpt-5-nano
# LLM=openai:gpt-5-nano
# SMART_LLM=openai:gpt-5-nano
# Required to save provider API keys via the Settings page. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Do not rotate this value without re-entering saved provider keys.
# Dual-read: prefer PM_PAL_SECRETS_MASTER_KEY (MARRDP_* still accepted)
PM_PAL_SECRETS_MASTER_KEY=
# MARRDP_SECRETS_MASTER_KEY=
# Dual-read: prefer PM_PAL_TEMPERATURE
PM_PAL_TEMPERATURE=0.2
# TEMPERATURE=0.2

# ---------------------------------------------------------------------------
# Logging and tracing
# Leave these defaults unless you are debugging or integrating observability.
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=human
# Dual-read: prefer PM_PAL_LLM_KWARGS
PM_PAL_LLM_KWARGS={}
# LLM_KWARGS={}
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=pm-pal

# ---------------------------------------------------------------------------
# Feishu integration
# Required only when you want Feishu documents, callbacks, or Feishu H5 usage.
# Runtime currently reads MARRDP_* only for these connector/webhook vars.
# For local mock testing you can keep signature verification disabled.
# ---------------------------------------------------------------------------
MARRDP_FEISHU_APP_ID=
MARRDP_FEISHU_APP_SECRET=
MARRDP_FEISHU_OPEN_BASE_URL=https://open.feishu.cn
MARRDP_FEISHU_SIGNATURE_DISABLED=true
MARRDP_FEISHU_WEBHOOK_SECRET=
MARRDP_FEISHU_ENCRYPT_KEY=
MARRDP_FEISHU_SIGNATURE_TOLERANCE_SEC=300
MARRDP_PUBLIC_BASE_URL=http://127.0.0.1:8000

# Local Feishu notification dry-run is enabled by default.
# Production should set dry-run to false and configure the selected channel.
MARRDP_FEISHU_NOTIFICATION_DRY_RUN=true
MARRDP_FEISHU_NOTIFICATION_CHANNELS=webhook
MARRDP_FEISHU_NOTIFICATION_RECEIVE_ID_TYPE=open_id
MARRDP_FEISHU_NOTIFICATION_DEFAULT_RECEIVE_ID=
MARRDP_FEISHU_NOTIFICATION_WEBHOOK_URL=
MARRDP_FEISHU_NOTIFICATION_TIMEOUT_SEC=10

# ---------------------------------------------------------------------------
# Notion integration
# Required only when you want to review Notion pages directly.
# Runtime reads MARRDP_* only. See docs/callback-config.md.
# ---------------------------------------------------------------------------
MARRDP_NOTION_TOKEN=
MARRDP_NOTION_API_BASE_URL=https://api.notion.com/v1
MARRDP_NOTION_API_VERSION=2022-06-28
MARRDP_NOTION_SIGNATURE_DISABLED=true
MARRDP_NOTION_SIGNING_SECRET=

# ---------------------------------------------------------------------------
# GitHub integration
# Required for GitHub connector sync (App or PAT). See docs/callback-config.md.
# Runtime reads MARRDP_* only.
# ---------------------------------------------------------------------------
MARRDP_GITHUB_SIGNATURE_DISABLED=true
MARRDP_GITHUB_WEBHOOK_SECRET=
MARRDP_GITHUB_AUTH_MODE=pat
MARRDP_GITHUB_APP_ID=
MARRDP_GITHUB_PRIVATE_KEY=
MARRDP_GITHUB_INSTALLATION_ID=
MARRDP_GITHUB_TOKEN=
MARRDP_GITHUB_API_BASE_URL=

# ---------------------------------------------------------------------------
# API bind (desktop defaults to loopback)
# Docker/shared servers typically use 0.0.0.0 via their own process command.
# ---------------------------------------------------------------------------
PM_PAL_HOST=127.0.0.1
PM_PAL_PORT=8000

# ---------------------------------------------------------------------------
# Shared deployment security
# Desktop/local default: auth OFF. For LAN/shared servers set:
#   PM_PAL_API_AUTH_DISABLED=false
#   PM_PAL_API_KEY=...   (startup fails if auth is on without a credential)
# ---------------------------------------------------------------------------
PM_PAL_API_AUTH_DISABLED=true
# MARRDP_API_AUTH_DISABLED=true
PM_PAL_API_KEY=
# MARRDP_API_KEY=
PM_PAL_API_BEARER_TOKEN=
# MARRDP_API_BEARER_TOKEN=
PM_PAL_API_RATE_LIMIT_DISABLED=true
PM_PAL_API_RATE_LIMIT_MAX_REQUESTS=5
PM_PAL_API_RATE_LIMIT_WINDOW_SEC=60

# ---------------------------------------------------------------------------
# Data directory (SQLite + outputs + connector state)
# Docker Compose mounts ./data to /app/data and sets this automatically.
# ---------------------------------------------------------------------------
PM_PAL_DATA_DIR=data
