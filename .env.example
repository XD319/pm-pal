# ---------------------------------------------------------------------------
# Minimal local setup
# Fill this part first if you only want to run the app locally.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
SMART_LLM=openai:gpt-5-nano
FAST_LLM=openai:gpt-5-nano
STRATEGIC_LLM=openai:gpt-5-nano
# Required to save API keys through Settings > Model connections. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Do not rotate this value without re-entering saved provider keys.
# Preferred public name: PRD_PAL_SECRETS_MASTER_KEY (MARRDP_* is the active reader today)
MARRDP_SECRETS_MASTER_KEY=
TEMPERATURE=0.2

# ---------------------------------------------------------------------------
# Logging and tracing
# Leave these defaults unless you are debugging or integrating observability.
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=human
LLM_KWARGS={}
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=prd-pal

# ---------------------------------------------------------------------------
# Feishu integration
# Required only when you want Feishu documents, callbacks, or Feishu H5 usage.
# PRD_PAL_* names are preferred public aliases; MARRDP_* is read at runtime today.
# For local mock testing you can keep signature verification disabled.
# ---------------------------------------------------------------------------
MARRDP_FEISHU_APP_ID=
# PRD_PAL_FEISHU_APP_ID=
MARRDP_FEISHU_APP_SECRET=
# PRD_PAL_FEISHU_APP_SECRET=
MARRDP_FEISHU_OPEN_BASE_URL=https://open.feishu.cn
MARRDP_FEISHU_SIGNATURE_DISABLED=true
# PRD_PAL_FEISHU_SIGNATURE_DISABLED=true
MARRDP_FEISHU_WEBHOOK_SECRET=
# PRD_PAL_FEISHU_WEBHOOK_SECRET=
MARRDP_FEISHU_ENCRYPT_KEY=
# PRD_PAL_FEISHU_ENCRYPT_KEY=
MARRDP_FEISHU_SIGNATURE_TOLERANCE_SEC=300
MARRDP_PUBLIC_BASE_URL=http://127.0.0.1:8000
# PRD_PAL_PUBLIC_BASE_URL=http://127.0.0.1:8000

# Local Feishu notification dry-run is enabled by default.
# Production should set dry-run to false and configure the selected channel.
MARRDP_FEISHU_NOTIFICATION_DRY_RUN=true
MARRDP_FEISHU_NOTIFICATION_CHANNELS=webhook
MARRDP_FEISHU_NOTIFICATION_RECEIVE_ID_TYPE=open_id
MARRDP_FEISHU_NOTIFICATION_DEFAULT_RECEIVE_ID=
MARRDP_FEISHU_NOTIFICATION_WEBHOOK_URL=
MARRDP_FEISHU_NOTIFICATION_TIMEOUT_SEC=10

# ---------------------------------------------------------------------------
# Notion integration
# Required only when you want to review Notion pages directly.
# See docs/callback-config.md for webhook signing setup.
# ---------------------------------------------------------------------------
MARRDP_NOTION_TOKEN=
# PRD_PAL_NOTION_TOKEN=
MARRDP_NOTION_API_BASE_URL=https://api.notion.com/v1
MARRDP_NOTION_API_VERSION=2022-06-28
MARRDP_NOTION_SIGNATURE_DISABLED=true
# PRD_PAL_NOTION_SIGNATURE_DISABLED=true
MARRDP_NOTION_SIGNING_SECRET=
# PRD_PAL_NOTION_SIGNING_SECRET=

# ---------------------------------------------------------------------------
# GitHub integration
# Required for GitHub connector sync (App or PAT). See docs/callback-config.md.
# ---------------------------------------------------------------------------
MARRDP_GITHUB_SIGNATURE_DISABLED=true
# PRD_PAL_GITHUB_SIGNATURE_DISABLED=true
MARRDP_GITHUB_WEBHOOK_SECRET=
# PRD_PAL_GITHUB_WEBHOOK_SECRET=
MARRDP_GITHUB_AUTH_MODE=pat
MARRDP_GITHUB_APP_ID=
MARRDP_GITHUB_PRIVATE_KEY=
MARRDP_GITHUB_INSTALLATION_ID=
MARRDP_GITHUB_TOKEN=
# PRD_PAL_GITHUB_TOKEN=
MARRDP_GITHUB_API_BASE_URL=

# ---------------------------------------------------------------------------
# Shared deployment security
# Keep disabled locally. Turn these on for shared or production environments.
# PRD_PAL_API_* are preferred public aliases.
# ---------------------------------------------------------------------------
MARRDP_API_AUTH_DISABLED=true
# PRD_PAL_API_AUTH_DISABLED=true
MARRDP_API_KEY=
# PRD_PAL_API_KEY=
MARRDP_API_BEARER_TOKEN=
# PRD_PAL_API_BEARER_TOKEN=
MARRDP_API_RATE_LIMIT_DISABLED=true
MARRDP_API_RATE_LIMIT_MAX_REQUESTS=5
MARRDP_API_RATE_LIMIT_WINDOW_SEC=60
